PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMTP settings for sending enquiry notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Address enquiry emails are sent from and to
MAIL_FROM="SKM Website <no-reply@skmegg.com>"
MAIL_TO=info@skmegg.com

# HR portal (/newhr). Generate the hash + secret with:
#   node backend/scripts/hash-hr-password.js "<password>"
HR_USERNAME=
HR_PASSWORD_HASH=
HR_SESSION_SECRET=
