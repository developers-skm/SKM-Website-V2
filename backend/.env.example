PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMTP settings for sending enquiry notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address (must be the SMTP account or a verified domain/alias).
# Recipients are NOT configured here: department routing lives in
# src/config/routing.js and is decided on the server.
MAIL_FROM="SKM Website <no-reply@skmegg.com>"

# Optional, staging only: send ALL mail to this one address instead of the
# real departments. Leave unset in production.
# MAIL_ROUTING_OVERRIDE_TO=you@skmegg.com

# HR portal (/newhr). Generate the hash + secret with:
#   node backend/scripts/hash-hr-password.js "<password>"
HR_USERNAME=
HR_PASSWORD_HASH=
HR_SESSION_SECRET=
